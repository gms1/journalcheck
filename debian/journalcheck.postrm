#!/bin/sh
set -e

case "$1" in
    purge)
        # Remove state directory on purge
        if [ -d /var/lib/journalcheck ]; then
            rm -rf /var/lib/journalcheck
        fi
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
esac

#DEBHELPER#

exit 0
